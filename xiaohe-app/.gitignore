# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
# Preserve the explicitly archived historical publication and QA evidence.
/outputs/*
!/outputs/xiaohe-release.tar.gz
!/outputs/xiaohe-access-release.tar.gz
!/outputs/deployment.json
!/outputs/access-deployment.json
!/outputs/qa/
/outputs/qa/*
!/outputs/qa/*.log
!/outputs/qa/*.json
!/outputs/qa/mobile.png
!/outputs/qa/content-web/
/outputs/qa/content-web/*
!/outputs/qa/content-web/browser-export.json
/work/

# OS metadata
.DS_Store
